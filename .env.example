OPENAI_API_KEY=sk-...

# --- Agent B ---
# Local dev: docker run -d --name itqan-pg -p 5432:5432 \
#   -e POSTGRES_PASSWORD=itqan_dev -e POSTGRES_DB=itqan \
#   -v itqan_pgdata:/var/lib/postgresql/data pgvector/pgvector:pg16
ITQAN_DATABASE_URL=postgresql://postgres:itqan_dev@localhost:5432/itqan

# Required before any live scrape. A bot that does not identify itself gives a
# site operator no option except to block it.
ITQAN_USER_AGENT=ItqanJobBot/0.1 (+you@example.com)

# Optional overrides
# ITQAN_MODEL=gpt-5.4-mini

# --- deployment (see DEPLOY.md) -------------------------------------------
# Anything other than "production" leaves the development defaults in place,
# which is what every local run and the whole test suite rely on.
ITQAN_ENV=development

# Session cookies are `user_id.HMAC(secret, user_id)`. The development fallback
# is public in this repository, so in production the app REFUSES TO BOOT without
# a real value here — every account would otherwise be forgeable.
#   python -c "import secrets;print(secrets.token_hex(32))"
ITQAN_SESSION_SECRET=

# Where uploads and per-run artifacts land. Unset, they go to ./output; the
# container mounts a volume at /data/output instead.
ITQAN_OUTPUT_DIR=

# docker-compose.yml only:
#   ITQAN_DOMAIN         hostname Caddy gets a TLS certificate for
#   POSTGRES_PASSWORD    the database password compose creates and connects with
