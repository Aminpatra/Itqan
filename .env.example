OPENAI_API_KEY=sk-...

# --- Agent B ---
# Local dev: docker run -d --name itqan-pg -p 5432:5432 \
#   -e POSTGRES_PASSWORD=itqan_dev -e POSTGRES_DB=itqan \
#   -v itqan_pgdata:/var/lib/postgresql/data pgvector/pgvector:pg16
ITQAN_DATABASE_URL=postgresql://postgres:itqan_dev@localhost:5432/itqan

# Required before any live scrape. A bot that does not identify itself gives a
# site operator no option except to block it.
ITQAN_USER_AGENT=ItqanJobBot/0.1 (+you@example.com)

# Optional overrides
# ITQAN_MODEL=gpt-5.4-mini

# --- deployment (see DEPLOY.md) -------------------------------------------
# Anything other than "production" leaves the development defaults in place,
# which is what every local run and the whole test suite rely on.
ITQAN_ENV=development

# Session cookies are `user_id.HMAC(secret, user_id)`. The development fallback
# is public in this repository, so in production the app REFUSES TO BOOT without
# a real value here — every account would otherwise be forgeable.
#   python -c "import secrets;print(secrets.token_hex(32))"
ITQAN_SESSION_SECRET=

# Where uploads and per-run artifacts land. Unset, they go to ./output; the
# container mounts a volume at /data/output instead.
ITQAN_OUTPUT_DIR=

# --- email (password recovery) ---
# REQUIRED IN PRODUCTION: the app refuses to boot without ITQAN_SMTP_HOST.
# Forgot-password answers 200 whether or not the address has an account — that is
# what stops the form revealing who is registered — so with no relay it would
# accept every request and send nothing, and nobody would find out. There is no
# user-visible symptom, so refusing to start is the only loud failure available.
ITQAN_SMTP_HOST=
ITQAN_SMTP_PORT=587
ITQAN_SMTP_USER=
ITQAN_SMTP_PASSWORD=
# The From address. Most relays require it to match ITQAN_SMTP_USER.
ITQAN_SMTP_FROM=
# STARTTLS on by default; set 0 only for a local test relay.
ITQAN_SMTP_STARTTLS=1

# Mail is OFF unless ITQAN_ENV=production. Set this to 1 only to test a real
# relay deliberately, for one run, and unset it again afterwards.
#
# It exists because a dev box and the test suite read THIS file, so they hold the
# production relay credentials. On 2026-08-20 one test run delivered ~200 messages
# to reserved-TLD addresses through the live account -- every one a hard bounce
# charged against the sender that real users' verification codes depend on. With
# sending off, a message is written to the log instead, code included, so the
# signup flow is still walkable locally.
ITQAN_SMTP_ENABLED=

# Where the emailed reset link points. This is the SITE origin — the marketing
# site owns /<ar|en>/forgot-password/ — not this API's.
ITQAN_SITE_URL=

# docker-compose.yml only:
#   ITQAN_DOMAIN         hostname Caddy gets a TLS certificate for
#   POSTGRES_PASSWORD    the database password compose creates and connects with
