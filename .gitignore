# Secrets — the repo root resolves to the home directory, so this matters.
.env
.env.*
!.env.example

# Per-run artifacts
output/

# The downloaded ESCO dataset (EU-published, ~50MB). Loaded into Postgres by
# `agent-b --esco-sync`; the repo carries only a small synthetic fixture.
ESCO/

# Legitimacy labels — real ingested postings a human labelled to measure filter
# precision. Never commit: a realistic scam posting in the repo is a working
# template. Covered by output/ above, repeated here so a relocated output dir
# cannot leak it.
**/legitimacy_labels*.jsonl

# Database dumps taken to move the corpus to the VPS. 26 MB gzipped for the four
# course tables alone, and a full dump is 1.7 GB — neither belongs in git, and a
# dump written to the repo root is one `git add -A` away from being committed.
# Take them outside the working tree; this is the backstop for when they are not.
# NOT a bare `*.sql`: migrations are tracked .sql files, and ignoring that
# extension would silently drop the next one from a commit.
*.sql.gz
corpus.sql

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
venv/
.venv/
